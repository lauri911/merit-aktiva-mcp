# Non-secret settings for server mode. Secrets go in deploy/secrets/ (see compose.yaml).

# The public HTTPS address of this server (what you add in claude.ai, without /mcp)
PUBLIC_URL=https://merit.example.com

# entra (Microsoft 365) or google
AUTH_PROVIDER=google
OAUTH_CLIENT_ID=
# Entra only: your tenant's ID
ENTRA_TENANT_ID=

# Who may use this server (comma separated)
ALLOWED_EMAILS=you@example.com

# Optional: the company's name (shown to Claude and in every write preview)
MERIT_COMPANY_NAME=

# true = also the write tools (invoices, payments, cards ...). Default: read only.
MERIT_ALLOW_WRITE=false

# Optional: anything Claude should know about how your company does its books
MERIT_EXTRA_INSTRUCTIONS=
